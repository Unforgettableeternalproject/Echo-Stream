# Echo Stream 設定範本
# 複製成 .env 後填入。.env 不進版控。
# 環境變數優先於這個檔案。

# ─────────────────────────────────────────────
# LLM（OpenAI Project）
# ─────────────────────────────────────────────

# 由艾斯維爾補上
OPENAI_API_KEY=

# OpenAI Project / Organization（用 Project 金鑰時通常不必再填，
# 但若金鑰橫跨多個 project 就需要指定）
OPENAI_PROJECT=
OPENAI_ORG=

# 自訂端點（走 Azure / 代理 / 相容閘道時才需要）
OPENAI_BASE_URL=

ECHO_STREAM_LLM_MODEL=gpt-5.6-luna

# API 路徑：chat（預設，context 完全由 ContextManager 掌控）
#           responses（支援 previous_response_id 做 server 端對話狀態）
# ⚠️ gpt-5.6-luna 在 chat 路徑不接受「記憶工具 + reasoning_effort」——帶 tools 的請求會被
#    自動降成 effort=none。要工具又要推理，改 responses
ECHO_STREAM_LLM_API=chat

# 推理強度：none / low / medium / high / xhigh / max
# ⚠️ 直接影響首字延遲——強度越高，吐出第一個 token 前思考得越久，
#    那段時間全部計入 TTFA。品質與延遲的取捨。
ECHO_STREAM_LLM_REASONING_EFFORT=high

# LLM 取樣參數
# ⚠️ 留空！gpt-5.6-luna 只接受預設值 1，傳任何自訂值會被 API 拒絕
#    （Unsupported value: 'temperature' does not support X with this model）
ECHO_STREAM_LLM_TEMPERATURE=
ECHO_STREAM_LLM_MAX_TOKENS=1024

# OpenAI prompt_cache_key：同值的請求路由到同一快取分片，提高前綴命中率（新 session 前幾輪
# cached_tokens=0 時可試）。留空 = 不帶。正常輪與預熱都會帶同一個值。
ECHO_STREAM_LLM_PROMPT_CACHE_KEY=

# 首句 filler：retrieve 還沒回來時先出聲的固定短語。
# ⚠️ 必須不含任何可被推翻的記憶斷言——「我不記得了」是斷言，不能用。
ECHO_STREAM_FILLER_ENABLED=false

# ─────────────────────────────────────────────
# 子系統 repo 路徑
# 留空會自動猜同層目錄（五個 repo 都在 Unforgettableeternalproject/ 底下），
# 通常不需要填。
# ─────────────────────────────────────────────

ECHO_STREAM_TTS_REPO=
ECHO_STREAM_STT_REPO=
ECHO_STREAM_MEMORY_REPO=
ECHO_STREAM_SESSION_REPO=

# ─────────────────────────────────────────────
# TTS（IndexTTS2）
# ─────────────────────────────────────────────

ECHO_STREAM_TTS_DEVICE=cuda
ECHO_STREAM_TTS_FP16=true
# 明確傳入 IndexTTS 的 GPT 加速選項；開啟後仍需確認後端實際生效與音質。
ECHO_STREAM_TTS_USE_ACCEL=false

# SpeakStage 的句子緩衝上限。有界是刻意的——無界會讓 TTS 一路合成到底，
# barge-in 就省不到 GPU 時間。
ECHO_STREAM_TTS_QUEUE=2

# ─────────────────────────────────────────────
# Web 前端
# ─────────────────────────────────────────────

ECHO_STREAM_WEB_HOST=127.0.0.1
ECHO_STREAM_WEB_PORT=8770

# ─────────────────────────────────────────────
# Memory（Echo Memory / EcphoryRAG，Phase 4a）
# ⚠ echo_memory repo 需在 develop 分支
#   （namespace / exclude_session_id API 已併入 develop）
#
# 關於 embedding：build_engine 不指定後端，沿用 echo_memory 的環境預設
#   （EMBEDDING_BACKEND 預設 sentence-transformers + bge-small-zh，CPU）。
#   bot／Memory 線若設 EMBEDDING_BACKEND=ollama + bge-m3（1024 維），與這裡不同。
#   兩邊不可共用同一個資料目錄：embedding_index.json 這份 manifest 記錄 model 與
#   dimension，不符時 echo_memory 會判定索引需重建，而不是靜默混用不同維度的向量。
#   要共用資料目錄，兩邊的 EMBEDDING_* 必須一致。
# ─────────────────────────────────────────────

# 記憶資料目錄（預設 Echo-Stream/data/memory，已 gitignore）
ECHO_STREAM_MEMORY_DATA=
# namespace 固定、跨會話（記憶跨會話是它存在的意義）
ECHO_STREAM_MEMORY_NAMESPACE=echo-stream
# 每次檢索取幾筆、注入 prompt 的文字上限（字元）
ECHO_STREAM_MEMORY_TOP_K=3
ECHO_STREAM_MEMORY_MAX_CHARS=500

# Dream 自動觸發（core/dream_scheduler.py）。兩種觸發：
#   idle     ：閒置 ≥ IDLE_MINUTES 且待蒸餾 episode ≥ MIN_PENDING
#   daydream ：待蒸餾 episode ≥ DAYDREAM_PENDING，不等閒置、對話中背景跑
# 「待蒸餾」= 未 dreamed 且 salience ≥ 0.5（與 echo_memory 蒸餾門檻對齊）
ECHO_STREAM_DREAM_IDLE_MINUTES=45
ECHO_STREAM_DREAM_MIN_PENDING=5
ECHO_STREAM_DREAM_DAYDREAM_PENDING=20

# -─────────────────────────────────────────────
# 系統提示詞
# -─────────────────────────────────────────────

SYSTEM_PROMPT=
# 檢索相似度下限（echo_memory 預設 0.3 會撈進純雜訊）
ECHO_STREAM_MEMORY_MIN_MATCH=0.45
# memory-check 的種子寫到獨立 namespace，不污染正式記憶
ECHO_STREAM_MEMORY_CHECK_NAMESPACE=echo-stream-check
# salience 評估（Phase 4b）：llm（每輪背景打一次低 reasoning 的 LLM）/ heuristic（零 token）/ off（全 0.5）
ECHO_STREAM_MEMORY_ASSESS=llm
# StorageJudge 微調（只在 assess=llm 時有效；JudgeGate 只在信號進灰區才打 LLM）：on / off
ECHO_STREAM_MEMORY_JUDGE=on
# 使用者 profile（dream 蒸餾出的 subject=user concept）注入 system prompt 的字元上限
ECHO_STREAM_MEMORY_PROFILE_MAX_CHARS=800
# profile 開頭附「常玩：X（最近 MM/DD）」的遊戲筆數（依累計時長）；0 停用。算在上面的字元上限內，優先保留
ECHO_STREAM_MEMORY_ACTIVITY_TOP_N=3
# LLM 可呼叫的記憶工具（逗號分隔；off 關閉）。deep_recall 純讀、force_remember 寫一筆高顯著性
# episode；adjust_importance / trigger_dream 讓模型自主決定風險高，預設不開
# member_recall（指名查詢同 guild 成員的共享投影）預設不開：要在此清單追加 member_recall，
# 且須保留 deep_recall,force_remember（例：deep_recall,force_remember,member_recall）；
# 另需宿主注入 member_resolver，否則工具不會曝光
# retract_about_me / opt_out_about_me / correct_about_me（使用者自助撤回、退出、糾正旁證）同樣預設不開，
# 需明列；宿主須在 tool_context["about_me"] 傳 scope_id / actor_uid（旁證編號由 member_recall 登記）
ECHO_STREAM_MEMORY_TOOLS=deep_recall,force_remember
# 工具結果回給 LLM 的字元上限
ECHO_STREAM_MEMORY_TOOL_MAX_CHARS=1500
# 模型開口前就決定查工具時先說的 filler（off 關閉）。⚠️ 不得含可被推翻的記憶斷言——
# 「我不記得了」禁用，「讓我想一下」才安全
ECHO_STREAM_TOOL_FILLER=嗯，讓我想一下。
# LLM 輸出防線：過濾模型偶發吐出的已知中文污染 token（如「天天彩票app」）。on / off，預設 on
ECHO_STREAM_OUTPUT_GUARD=on
# 追加的污染詞（逗號分隔，會與內建清單合併）。命中處連同其後緊接的 ASCII 尾巴一起剪掉
ECHO_STREAM_OUTPUT_BLOCKLIST_EXTRA=
